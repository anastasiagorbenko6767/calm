{
  "name": "calm-psychology-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,site -c green,cyan \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "android:add": "cap add android",
    "android:icons": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/make-android-icons.ps1",
    "android:build": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:run": "vite build && cap sync android && cap run android",
    "tunnel": "node scripts/tunnel.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.6",
    "vite": "^5.4.8"
  }
}
