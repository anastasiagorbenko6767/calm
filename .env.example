# Скопируйте этот файл в .env и заполните по потребности.

# Адрес сайта (нужен для ссылок в письмах)
SITE_URL=http://127.0.0.1:5173

# ---------- для Android-приложения через ngrok ----------
# Включает защищённые cookie (нужно для cross-site запросов из APK).
# Оставьте пустым, если работаете только в браузере на 127.0.0.1.
# COOKIE_SECURE=1

# Какие origin'ы пускать на /api. Через запятую, без пробелов.
# Для Capacitor Android (androidScheme: https) нужен "https://localhost".
# Для теста из браузера через ngrok добавьте адрес, который дал ngrok.
# CORS_ORIGINS=https://localhost,capacitor://localhost

# ---------- ИИ-помощник Квалм ----------
# Без ключа Квалм работает как offline-бот (распознаёт темы, отвечает шаблонами).
# С ключом переключается на настоящую нейросеть. Три варианта:
#
# --- 1) ЛОКАЛЬНАЯ модель через LM Studio (без интернета, приватно) ---
# Включите в LM Studio локальный сервер (вкладка Developer → Start server),
# загрузите модель (например, gemma-3-4b-it) — и пропишите:
# LLM_API_URL=http://127.0.0.1:1234/v1/chat/completions
# LLM_API_KEY=lm-studio
# LLM_MODEL=gemma-3-4b-it
#
# --- 2) Groq (облачно, бесплатно ~30 запросов/мин) ---
# Зарегистрируйтесь на https://console.groq.com, создайте ключ:
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# --- 3) OpenAI / другой совместимый сервис ---
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ---------- почта (не обязательно) ----------
# Пока SMTP не настроен, ссылки печатаются в терминале (строки [mail]).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=пароль_приложения
# MAIL_FROM=Calm <you@example.com>
